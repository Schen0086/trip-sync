# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Geoapify
# Server-only key used by authenticated API routes.
GEOAPIFY_API_KEY=YOUR_SERVER_GEOAPIFY_KEY

# Browser-visible map key.
# Restrict this key to your allowed origins/referrers in Geoapify.
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=YOUR_BROWSER_GEOAPIFY_MAP_KEY